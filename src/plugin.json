{
  "type": "datasource",
  "name": "InfluxDB",
  "id": "influxdb",
  "executable": "gpx_grafana_influxdb_datasource",
  "category": "tsdb",

  "defaultMatchFormat": "regex values",
  "metrics": true,
  "logs": true,
  "annotations": true,
  "alerting": true,
  "backend": true,

  "queryOptions": {
    "minInterval": true
  },

  "info": {
    "description": "Data source for InfluxDB, an open source time series database",
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "author": {
      "name": "Grafana Labs",
      "url": "https://grafana.com"
    },
    "logos": {
      "small": "img/influxdb_logo.svg",
      "large": "img/influxdb_logo.svg"
    },
    "keywords": ["influxdb", "influx", "tsdb", "datasource"],
    "links": [
      { "name": "Raise issue", "url": "https://github.com/grafana/grafana-influxdb-datasource/issues/new" },
      { "name": "Documentation", "url": "https://grafana.com/docs/grafana/latest/datasources/influxdb/" }
    ]
  },

  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
